# Copy to .env.local and fill in the real values.

# --- Public (safe to expose in the client bundle) ---
NEXT_PUBLIC_SITE_URL=https://freefall-news.web.app
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_ONESIGNAL_APP_ID=
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Must match the provider id shown in Firebase console > Authentication > Sign-in method
NEXT_PUBLIC_SMARTNEXUS_PROVIDER_ID=oidc.smartnexus

# --- Server-only (never exposed to the client) ---
SANITY_TOKEN=
ONESIGNAL_API_KEY=
RESEND_API_KEY=
RESEND_FROM=Free-Fall News <onboarding@resend.dev>
RESEND_AUDIENCE_NAME=Free-Fall Newsletter
# Shared secret the Sanity webhook sends in the Authorization header to the worker
NOTIFY_SECRET=
# URL of the free Cloudflare Worker (https://freefall-notify.<account>.workers.dev)
NEXT_PUBLIC_NOTIFY_URL=
